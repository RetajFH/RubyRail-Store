<div class="sn-page">
  <style>
    .sn-page {
      max-width: 400px;
      margin: 4rem auto;
      padding: 0 1.5rem;
    }

    .sn-eyebrow {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 0.4rem;
    }

    .sn-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: clamp(1.5rem, 4vw, 1.9rem);
      margin: 0 0 1.75rem;
      letter-spacing: -0.01em;
    }

    .sn-flash {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.8rem;
      border-radius: 5px;
      padding: 0.65rem 0.9rem;
      margin-bottom: 1.25rem;
    }

    .sn-flash.alert { background: var(--warn-soft); color: var(--warn); }
    .sn-flash.notice { background: var(--accent-soft); color: var(--accent); }

    .sn-form { display: flex; flex-direction: column; gap: 1rem; }

    .sn-field { display: flex; flex-direction: column; gap: 0.4rem; }

    .sn-field label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .sn-field input {
      border: 1px solid var(--line);
      border-radius: 5px;
      padding: 0.7rem 0.8rem;
      font-family: 'Public Sans', sans-serif;
      font-size: 0.9rem;
      color: var(--ink);
      background: #fff;
      width: 100%;
    }

    .sn-field input:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }

    .sn-submit {
      margin-top: 0.5rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 5px;
      padding: 0.75rem 1rem;
      cursor: pointer;
      transition: opacity .15s ease;
    }

    .sn-submit:hover { opacity: 0.85; }
    .sn-submit:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .sn-forgot {
      display: inline-block;
      margin-top: 1.25rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.8rem;
      color: var(--muted);
      text-decoration: none;
      border-bottom: 1px dashed var(--muted);
    }

    .sn-forgot:hover { color: var(--ink); border-color: var(--ink); }

    @media (prefers-reduced-motion: reduce) {
      .sn-submit { transition: none; }
    }
  </style>

  <p class="sn-eyebrow">Store / Access</p>
  <h1 class="sn-title">Sign in</h1>

  <% if flash[:alert] %>
    <div class="sn-flash alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="sn-flash notice"><%= flash[:notice] %></div>
  <% end %>

  <%= form_with url: session_path, class: "sn-form" do |form| %>
    <div class="sn-field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address,
            required: true,
            autofocus: true,
            autocomplete: "username",
            placeholder: "Enter your email address",
            value: params[:email_address] %>
    </div>

    <div class="sn-field">
      <%= form.label :password, "Password" %>
      <%= form.password_field :password,
            required: true,
            autocomplete: "current-password",
            placeholder: "Enter your password",
            maxlength: 72 %>
    </div>

    <%= form.submit "Sign in", class: "sn-submit" %>
  <% end %>

  <%= link_to "Forgot password?", new_password_path, class: "sn-forgot" %>
</div>