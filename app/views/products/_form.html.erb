<%= form_with model: product, class: "pf-form" do |form| %>
  <% if form.object.errors.any? %>
    <p class="pf-error">
      <%= form.object.errors.full_messages.first %>
    </p>
  <% end %>

  <div class="pf-field">
    <%= form.label :featured_image %>
    <%= form.file_field :featured_image, accept: "image/*" %>
  </div>

  <div class="pf-field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="pf-row">
    <div class="pf-field">
      <%= form.label :price %>
      <%= form.number_field :price, step: 0.01 %>
    </div>

    <div class="pf-field">
      <%= form.label :inventory_count %>
      <%= form.number_field :inventory_count %>
    </div>
  </div>

  <div class="pf-field">
    <%= form.label :sizes %>
    <%= form.text_field :sizes,
          value: form.object.sizes&.join(", "),
          placeholder: "Small, Medium, Large" %>
  </div>

  <!-- Cities -->
 <div class="pf-cities">
  <%= form.label :city_ids, "Available in", class: "pf-cities-label" %>

  <p class="pf-cities-hint">
    Select the cities where this product is available.
  </p>

  <% if City.exists? %>
    <div class="pf-city-list">
      <%= form.collection_check_boxes :city_ids, City.order(:name), :id, :name do |city| %>
        <label class="pf-city-option">
          <%= city.check_box %>
          <span><%= city.text %></span>
        </label>
      <% end %>
    </div>
  <% else %>
    <div class="pf-no-cities">
      No cities available. Add a city first.
    </div>
  <% end %>
</div>

  <div class="pf-field">
    <%= form.label :description %>
    <%= form.rich_textarea :description %>
  </div>

  <div>
    <%= form.submit class: "pf-submit" %>
  </div>

<% end %>