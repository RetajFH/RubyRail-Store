<%= form_with model: product, class: "pf-form" do |form| %>
  <style>
    .pf-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      max-width: 560px;
    }

    .pf-error {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.8rem;
      color: var(--warn);
      background: var(--warn-soft);
      border-radius: 5px;
      padding: 0.75rem 1rem;
      margin: 0 0 0.25rem;
    }

    .pf-field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .pf-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    @media (min-width: 600px) {
      .pf-row {
        grid-template-columns: 1fr 1fr;
      }
    }

    .pf-field label,
    .pf-cities-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .pf-field input[type="text"],
    .pf-field input[type="number"],
    .pf-field input[type="file"],
    .pf-field trix-editor {
      border: 1px solid var(--line);
      border-radius: 5px;
      padding: 0.65rem 0.75rem;
      font-family: 'Public Sans', sans-serif;
      font-size: 0.9rem;
      color: var(--ink);
      background: #fff;
      width: 100%;
      box-sizing: border-box;
    }

    .pf-field input:focus-visible,
    .pf-field trix-editor:focus {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }

    /* Cities */

    .pf-cities {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .pf-cities-hint {
      margin: 0;
      font-size: 0.78rem;
      color: var(--muted);
    }

    .pf-city-select {
      width: 100%;
      min-height: 150px;
      padding: 0.4rem;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: #fff;
      color: var(--ink);
      font-family: 'Public Sans', sans-serif;
      font-size: 0.9rem;
      outline: none;
      cursor: pointer;
    }

    .pf-city-select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px rgba(43, 76, 63, 0.12);
    }

    .pf-city-select option {
      padding: 0.65rem 0.75rem;
      border-radius: 4px;
    }

    .pf-city-select option:checked {
      background: var(--accent);
      color: #fff;
    }

    .pf-no-cities {
      border: 1px dashed var(--line);
      border-radius: 6px;
      padding: 1rem;
      background: #fafaf7;
      color: var(--muted);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
    }

    .pf-submit {
      align-self: flex-start;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 5px;
      padding: 0.7rem 1.4rem;
      cursor: pointer;
      transition: opacity .15s ease;
    }

    .pf-submit:hover {
      opacity: 0.85;
    }

    .pf-submit:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      .pf-submit {
        transition: none;
      }
    }
  </style>

  <% if form.object.errors.any? %>
    <p class="pf-error">
      <%= form.object.errors.full_messages.first %>
    </p>
  <% end %>

  <div class="pf-field">
    <%= form.label :featured_image %>
    <%= form.file_field :featured_image, accept: "image/*" %>
  </div>

  <div class="pf-field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="pf-row">
    <div class="pf-field">
      <%= form.label :price %>
      <%= form.number_field :price, step: 0.01 %>
    </div>

    <div class="pf-field">
      <%= form.label :inventory_count %>
      <%= form.number_field :inventory_count %>
    </div>
  </div>

  <div class="pf-field">
    <%= form.label :sizes %>
    <%= form.text_field :sizes,
          value: form.object.sizes&.join(", "),
          placeholder: "Small, Medium, Large" %>
  </div>

  <!-- Cities -->
 <div class="pf-cities">
  <%= form.label :city_ids, "Available in", class: "pf-cities-label" %>

  <p class="pf-cities-hint">
    Select the cities where this product is available.
  </p>

  <% if City.exists? %>
    <div class="pf-city-list">
      <%= form.collection_check_boxes :city_ids, City.order(:name), :id, :name do |city| %>
        <label class="pf-city-option">
          <%= city.check_box %>
          <span><%= city.text %></span>
        </label>
      <% end %>
    </div>
  <% else %>
    <div class="pf-no-cities">
      No cities available. Add a city first.
    </div>
  <% end %>
</div>

  <div class="pf-field">
    <%= form.label :description %>
    <%= form.rich_textarea :description %>
  </div>

  <div>
    <%= form.submit class: "pf-submit" %>
  </div>

<% end %>