<div class="sp-page">
  <style>
    .sp-page {
      max-width: 1080px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }

    .sp-back {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      color: var(--muted);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      margin-bottom: 1.5rem;
    }

    .sp-back:hover { color: var(--accent); }

    .sp-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    @media (min-width: 768px) {
      .sp-layout {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: start;
      }
    }

    .sp-image {
      aspect-ratio: 4 / 3;
      background: #F2F1EC;
      border: 1px dashed var(--line);
      border-radius: 8px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .sp-image img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .sp-image-empty {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 2.5rem;
      color: var(--muted);
    }

    .sp-info { display: flex; flex-direction: column; gap: 1.25rem; }

    .sp-name {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: clamp(1.5rem, 3vw, 2.2rem);
      margin: 0;
      letter-spacing: -0.01em;
    }

    .sp-price {
      display: inline-flex;
      align-self: flex-start;
      align-items: center;
      gap: 0.4rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 1.1rem;
      color: var(--accent);
      background: var(--accent-soft);
      border-radius: 5px;
      padding: 0.5rem 0.9rem;
    }

    .sp-price::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
    }

    .sp-description {
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--ink);
      border-top: 1px solid var(--line);
      padding-top: 1.1rem;
    }

    .sp-inventory { font-size: 0.85rem; color: var(--muted); }

    .sp-actions {
      display: flex;
      gap: 0.75rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--line);
    }

    .sp-edit {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--ink);
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 0.55rem 1rem;
      transition: border-color .15s ease, color .15s ease;
    }

    .sp-edit:hover { border-color: var(--accent); color: var(--accent); }

    .sp-delete {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      background: transparent;
      color: var(--warn);
      border: 1px solid var(--warn);
      border-radius: 4px;
      padding: 0.55rem 1rem;
      cursor: pointer;
      transition: background .15s ease, color .15s ease;
    }

    .sp-delete:hover { background: var(--warn); color: #fff; }

    @media (prefers-reduced-motion: reduce) {
      .sp-edit, .sp-delete { transition: none; }
    }
    .sp-sizes {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.sp-sizes-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}

.sp-sizes-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.sp-size-tag {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem;
  border: 1px solid var(--line);
  border-radius: 4px;
  padding: 0.3rem 0.65rem;
  color: var(--ink);
}
  </style>

  <%= link_to products_path, class: "sp-back" do %>&larr; Back to catalogue<% end %>

  <div class="sp-layout">
    <div class="sp-image">
      <% if @product.featured_image.attached? %>
       <%= image_tag @product.featured_image %>
      <% else %>
        <span class="sp-image-empty"><%= @product.name.presence&.first&.upcase || "?" %></span>
      <% end %>
    </div>

    <div class="sp-info">
      <% cache @product do %>
        <h1 class="sp-name"><%= @product.name.presence || "Untitled item" %></h1>
        <span class="sp-price"><%= number_to_currency(@product.price) %></span>
        <div class="sp-description"><%= @product.description %></div>
      <% end %>
      <% if @product.sizes.present? %>
      <div class="sp-sizes">
        <span class="sp-sizes-label">Available sizes</span>
        <div class="sp-sizes-list">
          <% @product.sizes.each do |size| %>
          <span class="sp-size-tag"><%= size %></span>
          <% end %>
        </div>
      </div>
      <%end%>
      <div class="sp-inventory">
        <%= render "inventory", product: @product %>
      </div>

      <% if authenticated? %>
        <div class="sp-actions">
          <%= link_to "Edit", edit_product_path(@product), class: "sp-edit" %>
          <%= button_to "Delete", @product, method: :delete, class: "sp-delete", data: { turbo_confirm: "Are you sure?" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>