<% content_for :title, "Catalogue" %>

<div class="sc-page">
  <div class="sc-topbar">
    <div>
      <p class="sc-eyebrow">Store / Catalogue</p>
      <h1 class="sc-title"><%= t ".title" %></h1>
    </div>

    <nav class="sc-nav">
      <%= link_to "sign up" ,  new_registration_path unless authenticated?  %>
      <%= link_to "Login", new_session_path unless authenticated? %>
      <%= link_to "New product", new_product_path if admin?   %>
      <%= link_to "city", cities_path if admin?   %>
    </nav>
  </div>

  <%= form_with url: products_path, method: :get, local: true do |f| %>
    <div class="sc-ledger">
      <span class="sc-ledger-label">Filter by price</span>

      <div class="sc-field">
        <span>$</span>
        <%= f.number_field :min_price,
          value: params[:min_price],
          placeholder: "min" %>
      </div>

      <span class="sc-arrow">&rarr;</span>

      <div class="sc-field">
        <span>$</span>
        <%= f.number_field :max_price,
          value: params[:max_price],
          placeholder: "max" %>
      </div>

      <span class="sc-ledger-label">Search</span>
 <div class="sc-field">
      <%= f.text_field :search_name,
        value: params[:search_name],
        placeholder: "search by name" %>
 </div>
      <%= f.submit "Filter", class: "sc-submit" %>

      <%= link_to "Clear", products_path, class: "sc-clear" %>
    </div>
  <% end %>

  <% if @products.any? %>
    <div class="sc-grid">
      <% @products.each do |product| %>
        <%= link_to product_path(product), class: "sc-card" do %>
          <div class="sc-thumb">
            <% if product.featured_image.attached? %>
              <%= image_tag product.featured_image %>
            <% else %>
              <span class="sc-monogram">
                <%= product.name.presence&.first&.upcase || "?" %>
              </span>
            <% end %>
          </div>

          <p class="sc-name<%= " untitled" if product.name.blank? %>">
            <%= product.name.presence || "Untitled item" %>
          </p>

          <div class="sc-price" data-id="<%= product.id %>">
            <%= number_to_currency(product.price) %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="sc-empty">
      No items match this range.
      <%= link_to "Clear the filter", products_path %>
      to see the full catalogue.
    </div>
  <% end %>
</div>