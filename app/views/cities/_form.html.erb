<%= form_with model: city , class: "pf-form" do |form| %>

  <% if city.errors.any? %>
    <div>
      <% city.errors.full_messages.each do |message| %>
        <p class="pf-error"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="pf-field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
  </div>

  <%= form.submit class: "pf-submit"%>

<% end %>